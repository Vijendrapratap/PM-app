PORT=5000

# Supabase project (Settings > API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origin allowed to call this API (your deployed frontend URL)
FRONTEND_URL=http://localhost:5173

# Optional hosted drafting provider. If omitted, PM/BA drafts use the local
# structured provider. Keep this key on the backend only—never in VITE_* vars.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.5

# Optional OpenRouter provider. When both hosted keys are present, OpenRouter
# takes precedence. The local structured provider remains the final fallback.
OPENROUTER_API_KEY=
# The requested "~deepseek/deepseek-v4-flash-latest" alias is accepted and
# normalized to OpenRouter's canonical model ID below.
OPENROUTER_AGENT_MODEL=deepseek/deepseek-v4-flash

# Used once at server boot to seed the first Super Admin account if no
# Super Admin exists yet (registration is public/self-service for everyone
# else). Safe to leave set after that (a no-op once seeded).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Only needed once, to run scripts/migrate-mongo-to-postgres.ts. Safe to remove afterwards.
MONGO_URI=
